# ==============================================================================
# Базові правила для виявлення вторгнень у локальній мережі підприємства
# ==============================================================================

# 1. Фіксація сканування портів Nmap SYN Scan
alert tcp any any -> $HOME_NET any (msg:"SCAN Nmap TCP SYN scan detected"; flags:S,12; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# 2. Фіксація перебору паролів SSH (Brute-Force)
alert tcp any any -> $HOME_NET 22 (msg:"ATTACK SSH Brute Force Login Attempt"; flow:to_server,established; content:"SSH-"; threshold:type both, track by_src, count 5, seconds 30; classtype:suspicious-login; sid:1000002; rev:1;)

# 3. Фіксація лавинного шторму TCP SYN Flood
alert tcp any any -> $HOME_NET any (msg:"DOS TCP SYN Flood Storm detected"; flags:S; threshold:type threshold, track by_dst, count 500, seconds 2; classtype:denial-of-service; sid:1000003; rev:1;)

# 4. Фіксація підозрілих SQL-ін'єкцій у HTTP-запитах
alert http any any -> $HTTP_SERVERS any (msg:"EXPLOIT Potential SQL Injection Attempt"; flow:to_server,established; content:"UNION"; nocase; http_uri; content:"SELECT"; nocase; http_uri; classtype:web-application-attack; sid:1000004; rev:1;)
